# Unity .gitattributes
# Based on: https://github.com/gitattributes/gitattributes/blob/master/Unity.gitattributes (MIT)
#
# 方針: LFS を使うのは Artist/ 以下だけ。
#       Assets/ や Packages/ など Unity 側は通常の Git で管理する。

# Define macros (only works in top-level gitattributes files)
[attr]lfs               filter=lfs diff=lfs merge=lfs -text
[attr]unity-json        eol=lf linguist-language=json
[attr]unity-yaml        merge=unityyamlmerge eol=lf linguist-language=yaml

# Unity source files
*.cginc                 text
*.compute               text linguist-language=hlsl
*.cs                    text diff=csharp eol=lf
*.hlsl                  text linguist-language=hlsl
*.raytrace              text linguist-language=hlsl
*.shader                text

# C# project files (force LF regardless of local core.autocrlf)
*.csproj                text eol=lf
*.sln                   text eol=lf
*.editorconfig          text eol=lf

# Git hooks (bash) must stay LF, batch files CRLF
.githooks/*            text eol=lf
*.bat                   text eol=crlf

# Unity JSON files
*.asmdef                unity-json
*.asmref                unity-json
*.index                 unity-json
*.inputactions          unity-json
*.shadergraph           unity-json
*.shadersubgraph        unity-json

# Unity UI Toolkit files
*.tss                   text diff=css linguist-language=css
*.uss                   text diff=css linguist-language=css
*.uxml                  text linguist-language=xml linguist-detectable

# Unity YAML files
*.anim                  unity-yaml
*.asset                 unity-yaml
*.brush                 unity-yaml
*.controller            unity-yaml
*.flare                 unity-yaml
*.fontsettings          unity-yaml
*.giparams              unity-yaml
*.guiskin               unity-yaml
*.lighting              unity-yaml
*.mask                  unity-yaml
*.mat                   unity-yaml
*.meta                  unity-yaml
*.mixer                 unity-yaml
*.overrideController    unity-yaml
*.playable              unity-yaml
*.prefab                unity-yaml
*.preset                unity-yaml
*.renderTexture         unity-yaml
*.scenetemplate         unity-yaml
*.shadervariants        unity-yaml
*.signal                unity-yaml
*.spriteatlas           unity-yaml
*.spriteatlasv2         unity-yaml
*.terrainlayer          unity-yaml
*.unity                 unity-yaml

# "physic" for 3D but "physics" for 2D
*.physicMaterial        unity-yaml
*.physicsMaterial2D     unity-yaml

# Exclude from GitHub stats and diffs: third-party plugins, packages lock file
Assets/Plugins/**           linguist-generated
Packages/packages-lock.json linguist-generated

# Exceptions for .asset files such as lightning pre-baking
LightingData.asset     binary

# Unity 側のバイナリは通常の Git で管理（改行変換などされないよう binary 指定）
*.png                   binary
*.jpg                   binary
*.jpeg                  binary
*.tga                   binary
*.psd                   binary
*.exr                   binary
*.hdr                   binary
*.wav                   binary
*.mp3                   binary
*.ogg                   binary
*.fbx                   binary
*.FBX                   binary
*.dll                   binary
*.ttf                   binary
*.otf                   binary
*.pdf                   binary
*.zip                   binary
*.exe                   binary

# ===== LFS: Artist フォルダ内の DCC ソースファイルのみ =====
Artist/**/*.mb          lfs
Artist/**/*.ma          lfs
Artist/**/*.atom        lfs
Artist/**/*.psd         lfs
Artist/**/*.spp         lfs
Artist/**/*.sbs         lfs
Artist/**/*.hdanc       lfs
Artist/**/*.hipnc       lfs
Artist/**/*.fbx         lfs
Artist/**/*.FBX         lfs

# Designer asset lock (作成者以外の編集を禁止する疑似排他制御)
# ロック未所有のファイルはチェックアウト時に read-only になる。
# 自動ロック取得/チェックは .githooks/pre-commit で行う。
Assets/Designer/**/*.mb     lockable
Artist/**/*.mb     lockable
Assets/Designer/**/*.fbx    lockable
Artist/**/*.fbx    lockable
Assets/Designer/**/*.FBX    lockable
Artist/**/*.FBX    lockable
Assets/Designer/**/*.abc    lockable
Artist/**/*.abc    lockable

