  m_ActivationSlot: {fileID: 8926484042661614934}
  m_BlockName: Wall Smoke
  m_HLSLCode: "void DoorSmoke(inout VFXAttributes attributes, in float Width, in
    float Height, in float Depth)\n{\n    float y = pow(Rand(attributes.seed), 1.3)
    * max(Height, 0.0);\n    attributes.position = float3((Rand(attributes.seed)
    - 0.5) * max(Width, 0.0), y, (Rand(attributes.seed) - 0.5) * Depth);\n    attributes.velocity
    = float3(0.0, 0.0, 0.0);\n}\n"
  m_ShaderFile: {fileID: 0}
  m_AvailableFunction:
    selection: DoorSmoke
    selectedIndex: 0
