  - {fileID: 8926484042661614984}
  - {fileID: 8926484042661614985}
  - {fileID: 8926484042661614986}
  m_OutputSlots: []
  m_Disabled: 0
  m_ActivationSlot: {fileID: 8926484042661614972}
  m_BlockName: Glow Pulse
  m_HLSLCode: "void GlowPulse(inout VFXAttributes attributes, in float Glow, in float
    PulseSpeed, in float PulseAmount, in float Depth, in float DepthFade, in float
    Height, in float TopFade, in float ParticleScale)\n{\n    float pulse = 1.0 +
    PulseAmount * sin(_Time.y * PulseSpeed * 6.2831853);\n    attributes.color *=
    Glow * pulse;\n    attributes.size *= ParticleScale;\n    float depth = saturate(abs(attributes.position.z)
    / max(Depth * 0.5, 0.01));\n    float top = saturate(attributes.position.y /
    max(Height, 0.01));\n    attributes.alpha *= (1.0 - smoothstep(saturate(DepthFade),
    1.0, depth)) * (1.0 - smoothstep(saturate(TopFade), 1.0, top));\n}\n"
  m_ShaderFile: {fileID: 0}
  m_AvailableFunction:
    selection: GlowPulse
    selectedIndex: 0
