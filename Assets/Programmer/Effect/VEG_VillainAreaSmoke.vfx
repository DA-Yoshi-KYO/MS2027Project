  m_Name: 
  m_EditorClassIdentifier: Unity.VisualEffectGraph.Editor::UnityEditor.VFX.Block.CustomHLSL
  m_UIIgnoredErrors: []
  m_Parent: {fileID: 114063133802684794}
  m_Children: []
  m_UIPosition: {x: 0, y: 0}
  m_UICollapsed: 0
  m_UISuperCollapsed: 0
  m_InputSlots:
  - {fileID: 8926484042661614969}
  - {fileID: 8926484042661614970}
  - {fileID: 8926484042661614971}
  - {fileID: 8926484042661614989}
  - {fileID: 8926484042661614990}
  - {fileID: 8926484042661614984}
  - {fileID: 8926484042661614985}
  - {fileID: 8926484042661614986}
  m_OutputSlots: []
  m_Disabled: 0
  m_ActivationSlot: {fileID: 8926484042661614972}
  m_BlockName: Glow Pulse
  m_HLSLCode: "void GlowPulse(inout VFXAttributes attributes, in float Glow, in float PulseSpeed, in float PulseAmount, in float Depth, in float DepthFade, in float Height, in float TopFade, in float ParticleScale)\n{\n    float pulse = 1.0 + PulseAmount * sin(_Time.y * PulseSpeed * 6.2831853);\n    attributes.color *= Glow * pulse;\n    attributes.size *= ParticleScale * (attributes.direction.y > 0.0 ? attributes.direction.y : 1.0);\n    // 前後・上の透明は、入口の壁になじんだ粒だけにかける(流れている途中は消さない)\n    float depth = saturate(abs(attributes.position.z) / max(Depth * 0.5, 0.01));\n    float top = saturate(attributes.position.y / max(Height, 0.01));\n    float wallFade = (1.0 - smoothstep(saturate(DepthFade), 1.0, depth)) * (1.0 - smoothstep(saturate(TopFade), 1.0, top));\n    // 濃さは寿命の割合(Color Over Life)ではなく、生まれてからの時間と入口に着いたかで決める\n    // (寿命が道のりで長くなるので、寿命の割合で消すと道の途中から薄くなるため)\n    float fadeIn = saturate(attributes.age / 1.5);\n    attributes.alpha = 0.24 * fadeIn * lerp(1.0, wallFade, attributes.direction.x) * (1.0 - attributes.direction.z);\n}\n"
  m_ShaderFile: {fileID: 0}
  m_AvailableFunction:
    selection: GlowPulse
    selectedIndex: 0
