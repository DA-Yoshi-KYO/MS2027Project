    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "// Outline takes the colour of the surface it surrounds (darkened), so it blends into the fill instead of a hard black line.\nColor = lerp(OutlineColor.rgb, Tex.rgb * Darken, saturate(Blend));"
