    "m_FunctionName": "NTE_CastShadowTint",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "ShadowTint = $precision4(max(SkinColor, 0.0) * saturate(Tint), saturate(Strength));"
}

