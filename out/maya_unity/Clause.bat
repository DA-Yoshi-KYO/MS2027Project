<# :
@echo off
setlocal
rem ===== Clause.bat : compress this folder into data.mpk.NNN + Unpack.ps1 + Open.bat =====
set "MPK_SELF=%~f0"
powershell -NoProfile -ExecutionPolicy Bypass -Command "iex ([IO.File]::ReadAllText($env:MPK_SELF))"
set "RC=%errorlevel%"
if not defined MPK_NOPAUSE pause
exit /b %RC%
#>
# ---------------------------------------------------------------------------
# ここから PowerShell。この Clause.bat が置かれたフォルダの中身を丸ごと圧縮し、
# 同じフォルダに以下を書き出す（既存は上書き）:
#   data.mpk.000, .001 ...  圧縮データ（48MB ごとに分割）
#   Unpack.ps1              解凍スクリプト（解凍器の C# ソースを内蔵）
#   Open.bat                Unpack.ps1 を起動するバッチ（ダブルクリックで復元）
# Clause.bat / Open.bat / Unpack.ps1 / data.mpk.* 自身は圧縮対象から除外する。
# 書き出したデータをディスクから読み直して解凍・SHA-256 照合し、問題がなければ
# 圧縮した元ファイルとフォルダを削除する（残したいときは環境変数 MPK_KEEP=1）。
# 別のフォルダ（例: DCClauncher）でも、この Clause.bat をコピーして実行すればよい。
#
# 圧縮方式: 同一ファイルの重複除去 + x86 BCJ フィルタ(ネイティブ exe/dll)
#           + ソリッド LZ77 (64MB 窓, 二分木マッチファインダ, 最適パース)
#           + 適応型2値算術符号（ハフマン符号を一般化したエントロピー符号）
# 環境変数で調整可: MPK_DICTBITS(既定26=64MB) MPK_NICE(既定128) MPK_CUT(既定48)
# ---------------------------------------------------------------------------
$ErrorActionPreference = 'Stop'
$self = $env:MPK_SELF
$dir = Split-Path -Parent $self
$toolFiles = @((Split-Path -Leaf $self), 'Clause.bat', 'Open.bat', 'Unpack.ps1')

$text = [IO.File]::ReadAllText($self)
function Get-Section([string]$name) {
    $m = [regex]::Match($text, '(?s)<#==' + $name + '==\r?\n(.*?)\r?\n==' + $name + '==#>')
    if (-not $m.Success) { throw "section $name not found" }
    return $m.Groups[1].Value
}
function Write-Crlf([string]$path, [string]$content, [bool]$bom) {
    $content = [regex]::Replace($content, '\r?\n', "`r`n")
    [IO.File]::WriteAllText($path, $content, (New-Object Text.UTF8Encoding($bom)))
}
$decCs = Get-Section 'DECODER_CS'
$encCs = Get-Section 'ENCODER_CS'
$unpackPs1 = Get-Section 'UNPACK_PS1'
$openBat = Get-Section 'OPEN_BAT'

$cp = New-Object System.CodeDom.Compiler.CompilerParameters
$cp.CompilerOptions = '/optimize+'
$cp.GenerateInMemory = $true
[void]$cp.ReferencedAssemblies.Add('System.dll')
Add-Type -TypeDefinition ($decCs + "`r`n" + $encCs) -Language CSharp -CompilerParameters $cp

$dictBits = 26; if ($env:MPK_DICTBITS) { $dictBits = [int]$env:MPK_DICTBITS }
$nice = 128;    if ($env:MPK_NICE) { $nice = [int]$env:MPK_NICE }
$cut = 48;      if ($env:MPK_CUT) { $cut = [int]$env:MPK_CUT }

$deleteSource = ($env:MPK_KEEP -ne '1')

# 解凍スクリプトを先に書き出す（元データを消す前に復元手段を揃えておく）
Write-Crlf (Join-Path $dir 'Unpack.ps1') ($unpackPs1.Replace('__DECODER_CS__', $decCs)) $true
Write-Crlf (Join-Path $dir 'Open.bat') $openBat $false

Write-Host "圧縮中: $dir"
$summary = [Mpk.Packer]::Pack($dir, $dir, 'data.mpk', [string[]]$toolFiles, $dictBits, $nice, $cut, 48MB, $deleteSource)
Write-Host $summary
if ($deleteSource) {
    Write-Host "書き出し完了: data.mpk.*, Unpack.ps1, Open.bat（圧縮した元ファイルは削除しました。Open.bat で復元できます）"
} else {
    Write-Host "書き出し完了: data.mpk.*, Unpack.ps1, Open.bat（MPK_KEEP=1 のため元ファイルは残しています）"
}
exit 0

<#==OPEN_BAT==
@echo off
setlocal
rem ===== Open.bat : restore this folder from data.mpk.NNN using Unpack.ps1 (generated by Clause.bat) =====
powershell -NoProfile -ExecutionPolicy Bypass -File "%~dp0Unpack.ps1" %*
set "RC=%errorlevel%"
if not defined MPK_NOPAUSE pause
exit /b %RC%
==OPEN_BAT==#>

<#==UNPACK_PS1==
# Unpack.ps1 - Clause.bat が自動生成した解凍スクリプト。Open.bat から実行される。
# 同じフォルダの data.mpk.NNN を読み、このフォルダの中身をバイト単位で元通りに復元する。
# 各ファイルは書き込む前に SHA-256 を照合する。
# Windows 標準の PowerShell 5.1 + .NET Framework (Add-Type) だけで動作する。
param([switch]$Force)
$ErrorActionPreference = 'Stop'
$here = Split-Path -Parent $MyInvocation.MyCommand.Path
$toolRx = '^(Clause\.bat|Open\.bat|Unpack\.ps1|data\.mpk\.\d{3})$'

$parts = @(Get-ChildItem -LiteralPath $here -File | Where-Object { $_.Name -match '^data\.mpk\.\d{3}$' } | Sort-Object Name | ForEach-Object { $_.FullName })
if ($parts.Count -eq 0) { throw "圧縮データ (data.mpk.000 ...) が見つかりません: $here" }

$existing = @(Get-ChildItem -LiteralPath $here -Force | Where-Object { $_.Name -notmatch $toolRx })
if ($existing.Count -gt 0 -and -not $Force) {
    $ans = Read-Host "$here には既にファイルがあります。同名ファイルを上書きして復元しますか? (y/N)"
    if ($ans -ne 'y' -and $ans -ne 'Y') { Write-Host '中止しました。'; exit 1 }
}

$cs = @'
__DECODER_CS__
'@
$cp = New-Object System.CodeDom.Compiler.CompilerParameters
$cp.CompilerOptions = '/optimize+'
$cp.GenerateInMemory = $true
[void]$cp.ReferencedAssemblies.Add('System.dll')
Add-Type -TypeDefinition $cs -Language CSharp -CompilerParameters $cp

Write-Host "解凍中: $($parts.Count) 個の圧縮データ -> $here"
$sw = [Diagnostics.Stopwatch]::StartNew()
$summary = [Mpk.Unpacker]::Unpack([string[]]$parts, $here)
Write-Host ("{0} ({1:0.0} 秒)" -f $summary, $sw.Elapsed.TotalSeconds)
Write-Host "復元完了: $here"
exit 0
==UNPACK_PS1==#>

<#==DECODER_CS==
using System;
using System.Collections.Generic;
using System.IO;
using System.IO.Compression;
using System.Security.Cryptography;
using System.Text;
using System.Text.RegularExpressions;

namespace Mpk
{
    // LZ77 + adaptive binary range coding (LZMA-style model, lc=3 lp=0 pb=2).
    public sealed class Model
    {
        public readonly ushort[] IsMatch = new ushort[12 << 4];
        public readonly ushort[] IsRep = new ushort[12];
        public readonly ushort[] IsRepG0 = new ushort[12];
        public readonly ushort[] IsRepG1 = new ushort[12];
        public readonly ushort[] IsRepG2 = new ushort[12];
        public readonly ushort[] IsRep0Long = new ushort[12 << 4];
        public readonly ushort[] PosSlot = new ushort[4 << 6];
        public readonly ushort[] PosSpec = new ushort[114];
        public readonly ushort[] Align = new ushort[16];
        public readonly ushort[] Lit = new ushort[0x300 << 3];
        // length model: [0]=choice [1]=choice2 [2+ps*8]=low [34+ps*8]=mid [66]=high
        public readonly ushort[] Len = new ushort[322];
        public readonly ushort[] RepLen = new ushort[322];

        public Model()
        {
            ushort[][] all = { IsMatch, IsRep, IsRepG0, IsRepG1, IsRepG2, IsRep0Long, PosSlot, PosSpec, Align, Lit, Len, RepLen };
            foreach (ushort[] a in all) for (int i = 0; i < a.Length; i++) a[i] = 1024;
        }
    }

    public sealed class RangeDecoder
    {
        readonly byte[] buf; int pos; uint range, code;
        public RangeDecoder(byte[] b, int start)
        {
            buf = b; pos = start; range = 0xFFFFFFFFu; code = 0;
            for (int i = 0; i < 5; i++) code = (code << 8) | Next();
        }
        byte Next() { if (pos < buf.Length) return buf[pos++]; pos++; return 0; }
        public bool Overrun { get { return pos > buf.Length + 5; } }
        public int Bit(ushort[] p, int i)
        {
            uint v = p[i]; uint bound = (range >> 11) * v; int bit;
            if (code < bound) { range = bound; p[i] = (ushort)(v + ((2048 - v) >> 5)); bit = 0; }
            else { code -= bound; range -= bound; p[i] = (ushort)(v - (v >> 5)); bit = 1; }
            if (range < (1u << 24)) { range <<= 8; code = (code << 8) | Next(); }
            return bit;
        }
        public uint Direct(int n)
        {
            uint res = 0;
            for (int i = 0; i < n; i++)
            {
                range >>= 1; uint t = (code - range) >> 31; code -= range & (t - 1); res = (res << 1) | (1 - t);
                if (range < (1u << 24)) { range <<= 8; code = (code << 8) | Next(); }
            }
            return res;
        }
        public int Tree(ushort[] p, int off, int n)
        {
            int m = 1; for (int i = 0; i < n; i++) m = (m << 1) | Bit(p, off + m);
            return m - (1 << n);
        }
        public int RevTree(ushort[] p, int off, int n)
        {
            int m = 1, s = 0;
            for (int i = 0; i < n; i++) { int b = Bit(p, off + m); m = (m << 1) | b; s |= b << i; }
            return s;
        }
    }

    public interface IByteSink { void Write(byte[] b, int off, int cnt); }

    public static class LzDecoder
    {
        static int DecLen(RangeDecoder rc, ushort[] p, int ps)
        {
            if (rc.Bit(p, 0) == 0) return rc.Tree(p, 2 + ps * 8, 3);
            if (rc.Bit(p, 1) == 0) return 8 + rc.Tree(p, 34 + ps * 8, 3);
            return 16 + rc.Tree(p, 66, 8);
        }

        public static void Decode(byte[] src, int start, long outLen, int dictBits, IByteSink sink)
        {
            RangeDecoder rc = new RangeDecoder(src, start);
            Model m = new Model();
            int R = 1 << dictBits;
            if (outLen < R) R = (int)Math.Max(outLen, 16);
            byte[] win = new byte[R];
            int wpos = 0, flushed = 0; long total = 0;
            int state = 0; uint r0 = 0, r1 = 0, r2 = 0, r3 = 0; int prev = 0;
            while (total < outLen)
            {
                int ps = (int)total & 3;
                if (rc.Bit(m.IsMatch, (state << 4) + ps) == 0)
                {
                    int b = 0x300 * (prev >> 5); int sym = 1;
                    if (state < 7) { while (sym < 0x100) sym = (sym << 1) | rc.Bit(m.Lit, b + sym); }
                    else
                    {
                        int mi = wpos - (int)r0 - 1; if (mi < 0) mi += R;
                        int mb = win[mi];
                        while (sym < 0x100)
                        {
                            int mbit = (mb >> 7) & 1; mb <<= 1;
                            int bit = rc.Bit(m.Lit, b + ((1 + mbit) << 8) + sym);
                            sym = (sym << 1) | bit;
                            if (mbit != bit) { while (sym < 0x100) sym = (sym << 1) | rc.Bit(m.Lit, b + sym); break; }
                        }
                    }
                    prev = sym & 0xFF; win[wpos++] = (byte)prev; total++;
                    if (wpos == R) { sink.Write(win, flushed, wpos - flushed); wpos = 0; flushed = 0; }
                    state = state < 4 ? 0 : (state < 10 ? state - 3 : state - 6);
                    continue;
                }
                int len;
                if (rc.Bit(m.IsRep, state) != 0)
                {
                    if (total == 0) throw new InvalidDataException("corrupt stream (rep at 0)");
                    if (rc.Bit(m.IsRepG0, state) == 0)
                    {
                        if (rc.Bit(m.IsRep0Long, (state << 4) + ps) == 0)
                        {
                            state = state < 7 ? 9 : 11;
                            int si = wpos - (int)r0 - 1; if (si < 0) si += R;
                            prev = win[si]; win[wpos++] = (byte)prev; total++;
                            if (wpos == R) { sink.Write(win, flushed, wpos - flushed); wpos = 0; flushed = 0; }
                            continue;
                        }
                    }
                    else
                    {
                        uint d;
                        if (rc.Bit(m.IsRepG1, state) == 0) d = r1;
                        else
                        {
                            if (rc.Bit(m.IsRepG2, state) == 0) d = r2; else { d = r3; r3 = r2; }
                            r2 = r1;
                        }
                        r1 = r0; r0 = d;
                    }
                    len = DecLen(rc, m.RepLen, ps);
                    state = state < 7 ? 8 : 11;
                }
                else
                {
                    r3 = r2; r2 = r1; r1 = r0;
                    len = DecLen(rc, m.Len, ps);
                    state = state < 7 ? 7 : 10;
                    int ls = len < 3 ? len : 3;
                    int slot = rc.Tree(m.PosSlot, ls << 6, 6);
                    if (slot >= 4)
                    {
                        int nd = (slot >> 1) - 1;
                        uint d = (uint)((2 | (slot & 1)) << nd);
                        if (slot < 14) d += (uint)rc.RevTree(m.PosSpec, (int)d - slot - 1, nd);
                        else { d += rc.Direct(nd - 4) << 4; d += (uint)rc.RevTree(m.Align, 0, 4); }
                        r0 = d;
                    }
                    else r0 = (uint)slot;
                }
                len += 2;
                if ((long)r0 >= total || r0 >= (uint)R) throw new InvalidDataException("corrupt stream (distance)");
                if (len > outLen - total) throw new InvalidDataException("corrupt stream (length)");
                int s = wpos - (int)r0 - 1; if (s < 0) s += R;
                total += len;
                while (len-- > 0)
                {
                    byte c = win[s++]; if (s == R) s = 0;
                    win[wpos++] = c;
                    if (wpos == R) { sink.Write(win, flushed, wpos - flushed); wpos = 0; flushed = 0; }
                }
                int pi = wpos - 1; if (pi < 0) pi += R; prev = win[pi];
                if (rc.Overrun) throw new InvalidDataException("corrupt stream (overrun)");
            }
            if (wpos > flushed) sink.Write(win, flushed, wpos - flushed);
        }
    }

    // x86 BCJ filter: E8/E9 rel32 <-> absolute (only values within +-16MB).
    public static class X86
    {
        public static void Run(byte[] d, int off, int len, bool encode)
        {
            int i = 0;
            while (i + 4 < len)
            {
                int o = off + i;
                if ((d[o] & 0xFE) == 0xE8)
                {
                    int v = d[o + 1] | (d[o + 2] << 8) | (d[o + 3] << 16) | (d[o + 4] << 24);
                    int top = v >> 24;
                    if (top == 0 || top == -1)
                    {
                        int a = encode ? v + (i + 5) : v - (i + 5);
                        a &= 0x1FFFFFF;
                        if ((a & 0x1000000) != 0) a |= unchecked((int)0xFE000000);
                        d[o + 1] = (byte)a; d[o + 2] = (byte)(a >> 8); d[o + 3] = (byte)(a >> 16); d[o + 4] = (byte)(a >> 24);
                    }
                    // Always skip the 4 operand bytes (converted or not), so encoder and
                    // decoder visit exactly the same opcode positions -> bijective.
                    i += 5; continue;
                }
                i++;
            }
        }
    }

    public sealed class Manifest
    {
        public int DictBits; public long StreamLen;
        public List<string> Dirs = new List<string>();
        public List<long> BlobLen = new List<long>();
        public List<byte> BlobFilter = new List<byte>();
        public List<byte[]> BlobHash = new List<byte[]>();
        public List<string> FilePath = new List<string>();
        public List<int> FileBlob = new List<int>();
        public List<long> FileTime = new List<long>();

        public byte[] Serialize()
        {
            MemoryStream raw = new MemoryStream();
            BinaryWriter w = new BinaryWriter(raw, new UTF8Encoding(false));
            w.Write(1); w.Write(DictBits); w.Write(StreamLen);
            w.Write(Dirs.Count); foreach (string s in Dirs) w.Write(s);
            w.Write(BlobLen.Count);
            for (int i = 0; i < BlobLen.Count; i++) { w.Write(BlobLen[i]); w.Write(BlobFilter[i]); w.Write(BlobHash[i]); }
            w.Write(FilePath.Count);
            for (int i = 0; i < FilePath.Count; i++) { w.Write(FilePath[i]); w.Write(FileBlob[i]); w.Write(FileTime[i]); }
            w.Flush();
            MemoryStream c = new MemoryStream();
            using (DeflateStream ds = new DeflateStream(c, CompressionMode.Compress, true)) { byte[] r = raw.ToArray(); ds.Write(r, 0, r.Length); }
            return c.ToArray();
        }

        public static Manifest Parse(byte[] a, int off, int len)
        {
            MemoryStream raw = new MemoryStream();
            using (DeflateStream ds = new DeflateStream(new MemoryStream(a, off, len), CompressionMode.Decompress)) ds.CopyTo(raw);
            raw.Position = 0;
            BinaryReader r = new BinaryReader(raw, new UTF8Encoding(false));
            Manifest m = new Manifest();
            if (r.ReadInt32() != 1) throw new InvalidDataException("unsupported version");
            m.DictBits = r.ReadInt32(); m.StreamLen = r.ReadInt64();
            int n = r.ReadInt32(); for (int i = 0; i < n; i++) m.Dirs.Add(r.ReadString());
            n = r.ReadInt32();
            for (int i = 0; i < n; i++) { m.BlobLen.Add(r.ReadInt64()); m.BlobFilter.Add(r.ReadByte()); m.BlobHash.Add(r.ReadBytes(32)); }
            n = r.ReadInt32();
            for (int i = 0; i < n; i++) { m.FilePath.Add(r.ReadString()); m.FileBlob.Add(r.ReadInt32()); m.FileTime.Add(r.ReadInt64()); }
            return m;
        }
    }

    public delegate void BlobDone(int index, byte[] data);

    public sealed class BlobSink : IByteSink
    {
        readonly Manifest m; readonly BlobDone done; int idx; byte[] cur; int fill;
        public BlobSink(Manifest m, BlobDone done) { this.m = m; this.done = done; Start(); }
        void Start()
        {
            while (idx < m.BlobLen.Count && m.BlobLen[idx] == 0) { done(idx, new byte[0]); idx++; }
            if (idx < m.BlobLen.Count) { cur = new byte[m.BlobLen[idx]]; fill = 0; } else cur = null;
        }
        public bool Complete { get { return idx >= m.BlobLen.Count; } }
        public void Write(byte[] b, int off, int cnt)
        {
            while (cnt > 0)
            {
                if (cur == null) throw new InvalidDataException("extra data in stream");
                int k = Math.Min(cnt, cur.Length - fill);
                Buffer.BlockCopy(b, off, cur, fill, k);
                fill += k; off += k; cnt -= k;
                if (fill == cur.Length) { byte[] d = cur; cur = null; done(idx, d); idx++; Start(); }
            }
        }
    }

    public static class Unpacker
    {
        public static readonly byte[] Magic = { (byte)'M', (byte)'P', (byte)'K', (byte)'1' };

        public static string Unpack(string[] parts, string dest)
        {
            MemoryStream ms = new MemoryStream();
            foreach (string p in parts) { byte[] b = File.ReadAllBytes(p); ms.Write(b, 0, b.Length); }
            return Run(ms.ToArray(), dest);
        }

        static string SafePath(string root, string rel)
        {
            if (rel.Length == 0 || rel.StartsWith("/") || rel.IndexOf(':') >= 0 || rel.IndexOf('\\') >= 0) throw new InvalidDataException("bad path: " + rel);
            foreach (string seg in rel.Split('/')) if (seg == ".." || seg == "." || seg.Length == 0) throw new InvalidDataException("bad path: " + rel);
            return Path.Combine(root, rel.Replace('/', Path.DirectorySeparatorChar));
        }

        // dest == null: verify only (decode + hash check, nothing written)
        public static string Run(byte[] a, string dest)
        {
            if (a.Length < 8 || a[0] != Magic[0] || a[1] != Magic[1] || a[2] != Magic[2] || a[3] != Magic[3]) throw new InvalidDataException("not an MPK archive");
            int mlen = BitConverter.ToInt32(a, 4);
            Manifest m = Manifest.Parse(a, 8, mlen);
            int start = 8 + mlen;
            List<int>[] filesOf = new List<int>[m.BlobLen.Count];
            for (int i = 0; i < filesOf.Length; i++) filesOf[i] = new List<int>();
            for (int i = 0; i < m.FilePath.Count; i++) filesOf[m.FileBlob[i]].Add(i);
            if (dest != null)
            {
                Directory.CreateDirectory(dest);
                foreach (string d in m.Dirs) Directory.CreateDirectory(SafePath(dest, d));
            }
            long written = 0;
            using (SHA256 sha = SHA256.Create())
            {
                BlobSink sink = new BlobSink(m, delegate(int bi, byte[] data)
                {
                    if (m.BlobFilter[bi] == 1) X86.Run(data, 0, data.Length, false);
                    byte[] h = sha.ComputeHash(data);
                    for (int k = 0; k < 32; k++) if (h[k] != m.BlobHash[bi][k]) throw new InvalidDataException("hash mismatch: " + (filesOf[bi].Count > 0 ? m.FilePath[filesOf[bi][0]] : bi.ToString()));
                    if (dest == null) return;
                    foreach (int fi in filesOf[bi])
                    {
                        string path = SafePath(dest, m.FilePath[fi]);
                        Directory.CreateDirectory(Path.GetDirectoryName(path));
                        File.WriteAllBytes(path, data);
                        File.SetLastWriteTimeUtc(path, new DateTime(m.FileTime[fi], DateTimeKind.Utc));
                        written += data.Length;
                    }
                });
                LzDecoder.Decode(a, start, m.StreamLen, m.DictBits, sink);
                if (!sink.Complete) throw new InvalidDataException("stream ended early");
            }
            return string.Format("{0} files, {1} dirs, {2:N0} bytes OK (SHA-256 verified)", m.FilePath.Count, m.Dirs.Count, dest == null ? m.StreamLen : written);
        }
    }
}
==DECODER_CS==#>

<#==ENCODER_CS==
namespace Mpk
{
    public sealed class RangeEncoder
    {
        readonly MemoryStream s; ulong low; uint range = 0xFFFFFFFFu; byte cache; long cacheSize = 1;
        public RangeEncoder(MemoryStream ms) { s = ms; }
        void ShiftLow()
        {
            if ((uint)low < 0xFF000000u || (uint)(low >> 32) != 0)
            {
                byte t = cache;
                do { s.WriteByte((byte)(t + (byte)(low >> 32))); t = 0xFF; } while (--cacheSize != 0);
                cache = (byte)((uint)low >> 24);
            }
            cacheSize++;
            low = (ulong)(((uint)low & 0x00FFFFFFu) << 8);
        }
        public void Bit(ushort[] p, int i, int bit)
        {
            uint v = p[i]; uint bound = (range >> 11) * v;
            if (bit == 0) { range = bound; p[i] = (ushort)(v + ((2048 - v) >> 5)); }
            else { low += bound; range -= bound; p[i] = (ushort)(v - (v >> 5)); }
            while (range < (1u << 24)) { range <<= 8; ShiftLow(); }
        }
        public void Direct(uint v, int n)
        {
            for (int i = n - 1; i >= 0; i--)
            {
                range >>= 1; if (((v >> i) & 1) != 0) low += range;
                while (range < (1u << 24)) { range <<= 8; ShiftLow(); }
            }
        }
        public void Tree(ushort[] p, int off, int n, int v)
        {
            int m = 1; for (int i = n - 1; i >= 0; i--) { int b = (v >> i) & 1; Bit(p, off + m, b); m = (m << 1) | b; }
        }
        public void RevTree(ushort[] p, int off, int n, int v)
        {
            int m = 1; for (int i = 0; i < n; i++) { int b = v & 1; v >>= 1; Bit(p, off + m, b); m = (m << 1) | b; }
        }
        public void Flush() { for (int i = 0; i < 5; i++) ShiftLow(); }
    }

    public delegate void Progress(long done, long total, long outBytes);

    public sealed class LzEncoder
    {
        const int NOPT = 4096, INF = 0x3FFFFFFF, H3B = 18;
        readonly byte[] buf; readonly int end, R, nice, cut, H4B;
        readonly int[] son, hash2, hash3, hash4;
        readonly int[] mLen = new int[300], mDist = new int[300];
        readonly Model m = new Model();
        readonly RangeEncoder rc; readonly MemoryStream outS;
        int state; readonly int[] reps = new int[4];
        readonly int[] oPrice = new int[NOPT + 300], oPrev = new int[NOPT + 300], oBack = new int[NOPT + 300], oState = new int[NOPT + 300], oRep = new int[(NOPT + 300) * 4];
        int lenEnd;
        readonly int[] tLen = new int[NOPT + 8], tBack = new int[NOPT + 8];
        static readonly int[] PP = MakePP();
        readonly int[] lenPr = new int[4 * 272], repLenPr = new int[4 * 272];
        readonly int[] slotPr = new int[4 * 64], fullDistPr = new int[4 * 128], alignPr = new int[16];
        readonly int[] repLens = new int[4];

        static int[] MakePP()
        {
            int[] t = new int[128];
            for (int i = 0; i < 128; i++) t[i] = (int)Math.Round(-Math.Log((i * 16 + 8) / 2048.0, 2) * 16);
            return t;
        }

        public LzEncoder(byte[] buf, int end, int dictBits, int nice, int cut, MemoryStream outS)
        {
            this.buf = buf; this.end = end; this.nice = Math.Max(8, Math.Min(273, nice)); this.cut = cut;
            R = 1 << dictBits; son = new int[2 * R];
            int hb = 24; while (hb > 16 && (1 << hb) > end) hb--; H4B = hb;
            hash2 = new int[65536]; hash3 = new int[1 << H3B]; hash4 = new int[1 << H4B];
            this.outS = outS; rc = new RangeEncoder(outS);
        }

        static int P0(ushort p) { return PP[p >> 4]; }
        static int P1(ushort p) { return PP[(2048 - p) >> 4]; }
        static int BitP(ushort p, int b) { return b == 0 ? PP[p >> 4] : PP[(2048 - p) >> 4]; }
        static int TreeP(ushort[] p, int off, int n, int v)
        {
            int pr = 0, mm = 1; for (int i = n - 1; i >= 0; i--) { int b = (v >> i) & 1; pr += BitP(p[off + mm], b); mm = (mm << 1) | b; }
            return pr;
        }
        static int RevTreeP(ushort[] p, int off, int n, int v)
        {
            int pr = 0, mm = 1; for (int i = 0; i < n; i++) { int b = v & 1; v >>= 1; pr += BitP(p[off + mm], b); mm = (mm << 1) | b; }
            return pr;
        }
        static int LenP(ushort[] p, int l, int ps)
        {
            if (l < 8) return P0(p[0]) + TreeP(p, 2 + ps * 8, 3, l);
            if (l < 16) return P1(p[0]) + P0(p[1]) + TreeP(p, 34 + ps * 8, 3, l - 8);
            return P1(p[0]) + P1(p[1]) + TreeP(p, 66, 8, l - 16);
        }
        static int GetSlot(int d)
        {
            if (d < 4) return d;
            uint x = (uint)d; int n = 0;
            if (x >= 1u << 16) { x >>= 16; n += 16; }
            if (x >= 1u << 8) { x >>= 8; n += 8; }
            if (x >= 16) { x >>= 4; n += 4; }
            if (x >= 4) { x >>= 2; n += 2; }
            if (x >= 2) n += 1;
            return (n << 1) | ((d >> (n - 1)) & 1);
        }

        void RefreshPrices()
        {
            for (int ps = 0; ps < 4; ps++)
                for (int l = 0; l < 272; l++) { lenPr[ps * 272 + l] = LenP(m.Len, l, ps); repLenPr[ps * 272 + l] = LenP(m.RepLen, l, ps); }
            for (int ls = 0; ls < 4; ls++)
            {
                for (int slot = 0; slot < 64; slot++)
                    slotPr[ls * 64 + slot] = TreeP(m.PosSlot, ls << 6, 6, slot) + (slot >= 14 ? (((slot >> 1) - 1 - 4) << 4) : 0);
                for (int d = 0; d < 128; d++)
                {
                    if (d < 4) { fullDistPr[ls * 128 + d] = slotPr[ls * 64 + d]; continue; }
                    int slot = GetSlot(d); int nd = (slot >> 1) - 1; int bv = (2 | (slot & 1)) << nd;
                    fullDistPr[ls * 128 + d] = slotPr[ls * 64 + slot] + RevTreeP(m.PosSpec, bv - slot - 1, nd, d - bv);
                }
            }
            for (int i = 0; i < 16; i++) alignPr[i] = RevTreeP(m.Align, 0, 4, i);
        }

        int DistPrice(int d, int ls)
        {
            if (d < 128) return fullDistPr[ls * 128 + d];
            return slotPr[ls * 64 + GetSlot(d)] + alignPr[d & 15];
        }

        int LitPrice(int p, int st, int r0)
        {
            int prevB = p > 0 ? buf[p - 1] : 0; int b = buf[p];
            int bs = 0x300 * (prevB >> 5); int pr = 0, sym = 1;
            if (st >= 7)
            {
                int mb = buf[p - r0 - 1];
                for (int i = 7; i >= 0; i--)
                {
                    int bit = (b >> i) & 1; int mbit = (mb >> i) & 1;
                    pr += BitP(m.Lit[bs + ((1 + mbit) << 8) + sym], bit); sym = (sym << 1) | bit;
                    if (mbit != bit)
                    {
                        for (i--; i >= 0; i--) { bit = (b >> i) & 1; pr += BitP(m.Lit[bs + sym], bit); sym = (sym << 1) | bit; }
                        break;
                    }
                }
            }
            else
            {
                for (int i = 7; i >= 0; i--) { int bit = (b >> i) & 1; pr += BitP(m.Lit[bs + sym], bit); sym = (sym << 1) | bit; }
            }
            return pr;
        }

        int RepIdxPrice(int i, int st, int ps)
        {
            if (i == 0) return P0(m.IsRepG0[st]) + P1(m.IsRep0Long[(st << 4) + ps]);
            int pr = P1(m.IsRepG0[st]);
            if (i == 1) return pr + P0(m.IsRepG1[st]);
            pr += P1(m.IsRepG1[st]);
            return pr + BitP(m.IsRepG2[st], i - 2);
        }

        // ---- binary tree match finder (positions stored +1, 0 = empty) ----
        int FindMatches(int p, bool skip)
        {
            int avail = end - p;
            if (avail < 4) return 0;
            int lenLimit = avail < nice ? avail : nice;
            int lo = p - R + 1; if (lo < 0) lo = 0;
            int n = 0, maxLen = 1;
            int h2 = buf[p] | (buf[p + 1] << 8);
            uint v3 = (uint)(h2 | (buf[p + 2] << 16));
            int h3 = (int)((v3 * 2654435761u) >> (32 - H3B));
            int h4 = (int)(((v3 | ((uint)buf[p + 3] << 24)) * 2654435761u) >> (32 - H4B));
            int c2 = hash2[h2] - 1, c3 = hash3[h3] - 1, cur = hash4[h4] - 1;
            hash2[h2] = p + 1; hash3[h3] = p + 1; hash4[h4] = p + 1;
            if (!skip)
            {
                if (c2 >= lo)
                {
                    int l = 0; while (l < lenLimit && buf[c2 + l] == buf[p + l]) l++;
                    if (l > maxLen) { maxLen = l; mLen[n] = l; mDist[n] = p - c2 - 1; n++; }
                }
                if (c3 >= lo && c3 != c2)
                {
                    int l = 0; while (l < lenLimit && buf[c3 + l] == buf[p + l]) l++;
                    if (l > maxLen) { maxLen = l; mLen[n] = l; mDist[n] = p - c3 - 1; n++; }
                }
            }
            int RM = R - 1;
            int ptr0 = ((p & RM) << 1) + 1, ptr1 = (p & RM) << 1;
            int len0 = 0, len1 = 0, cnt = cut;
            while (true)
            {
                if (cur < lo || cnt-- == 0) { son[ptr0] = 0; son[ptr1] = 0; break; }
                int cp = (cur & RM) << 1;
                int len = len0 < len1 ? len0 : len1;
                if (buf[cur + len] == buf[p + len])
                {
                    while (++len != lenLimit) if (buf[cur + len] != buf[p + len]) break;
                    if (len > maxLen) { maxLen = len; if (!skip) { mLen[n] = len; mDist[n] = p - cur - 1; n++; } }
                    if (len == lenLimit) { son[ptr1] = son[cp]; son[ptr0] = son[cp + 1]; break; }
                }
                if (buf[cur + len] < buf[p + len]) { son[ptr1] = cur + 1; ptr1 = cp + 1; cur = son[ptr1] - 1; len1 = len; }
                else { son[ptr0] = cur + 1; ptr0 = cp; cur = son[ptr0] - 1; len0 = len; }
            }
            return n;
        }

        void Upd(int idx, int price, int prev, int back)
        {
            while (lenEnd < idx) { lenEnd++; oPrice[lenEnd] = INF; }
            if (price < oPrice[idx]) { oPrice[idx] = price; oPrev[idx] = prev; oBack[idx] = back; }
        }

        // Price-based optimal parse over up to NOPT positions. Fills tLen/tBack, returns count.
        int Optimum(int pos)
        {
            oPrice[0] = 0; oState[0] = state;
            for (int i = 0; i < 4; i++) oRep[i] = reps[i];
            lenEnd = 0;
            int cur = 0, finalIdx, extraLen = 0, extraBack = 0;
            while (true)
            {
                int p = pos + cur;
                int st, r0, r1, r2, r3;
                if (cur == 0) { st = state; r0 = reps[0]; r1 = reps[1]; r2 = reps[2]; r3 = reps[3]; }
                else
                {
                    int pr = oPrev[cur], bk = oBack[cur], L = cur - pr;
                    st = oState[pr]; r0 = oRep[pr * 4]; r1 = oRep[pr * 4 + 1]; r2 = oRep[pr * 4 + 2]; r3 = oRep[pr * 4 + 3];
                    if (bk < 0) st = st < 4 ? 0 : (st < 10 ? st - 3 : st - 6);
                    else if (bk < 4)
                    {
                        if (bk == 0 && L == 1) st = st < 7 ? 9 : 11;
                        else
                        {
                            st = st < 7 ? 8 : 11;
                            if (bk == 1) { int t = r1; r1 = r0; r0 = t; }
                            else if (bk == 2) { int t = r2; r2 = r1; r1 = r0; r0 = t; }
                            else if (bk == 3) { int t = r3; r3 = r2; r2 = r1; r1 = r0; r0 = t; }
                        }
                    }
                    else { st = st < 7 ? 7 : 10; r3 = r2; r2 = r1; r1 = r0; r0 = bk - 4; }
                    oState[cur] = st; oRep[cur * 4] = r0; oRep[cur * 4 + 1] = r1; oRep[cur * 4 + 2] = r2; oRep[cur * 4 + 3] = r3;
                }
                if (p >= end || cur >= NOPT) { finalIdx = cur; break; }

                int nm = FindMatches(p, false);
                int avail = end - p; int maxL = avail < 273 ? avail : 273;
                int bestRep = 0, bestRepIdx = 0;
                for (int i = 0; i < 4; i++)
                {
                    int rd = i == 0 ? r0 : i == 1 ? r1 : i == 2 ? r2 : r3;
                    int s = p - rd - 1; int l = 0;
                    if (s >= 0 && maxL >= 2 && buf[s] == buf[p] && buf[s + 1] == buf[p + 1])
                    {
                        l = 2; while (l < maxL && buf[s + l] == buf[p + l]) l++;
                    }
                    repLens[i] = l;
                    if (l > bestRep) { bestRep = l; bestRepIdx = i; }
                }
                if (bestRep >= nice)
                {
                    finalIdx = cur; extraLen = bestRep; extraBack = bestRepIdx;
                    for (int k = 1; k < bestRep; k++) FindMatches(p + k, true);
                    break;
                }
                if (nm > 0 && mLen[nm - 1] >= nice)
                {
                    int l = mLen[nm - 1]; int s = p - mDist[nm - 1] - 1;
                    while (l < maxL && buf[s + l] == buf[p + l]) l++;
                    finalIdx = cur; extraLen = l; extraBack = mDist[nm - 1] + 4;
                    for (int k = 1; k < l; k++) FindMatches(p + k, true);
                    break;
                }

                int ps = p & 3; int curPrice = oPrice[cur];
                ushort pm = m.IsMatch[(st << 4) + ps];
                Upd(cur + 1, curPrice + P0(pm) + LitPrice(p, st, r0), cur, -1);
                int matchPrice = curPrice + P1(pm);
                int repMatchPrice = matchPrice + P1(m.IsRep[st]);
                int normalMatchPrice = matchPrice + P0(m.IsRep[st]);
                if (p - r0 - 1 >= 0 && buf[p - r0 - 1] == buf[p])
                    Upd(cur + 1, repMatchPrice + P0(m.IsRepG0[st]) + P0(m.IsRep0Long[(st << 4) + ps]), cur, 0);
                for (int i = 0; i < 4; i++)
                {
                    int rl = repLens[i]; if (rl < 2) continue;
                    int bp = repMatchPrice + RepIdxPrice(i, st, ps);
                    for (int L = 2; L <= rl; L++) Upd(cur + L, bp + repLenPr[ps * 272 + L - 2], cur, i);
                }
                int startL = repLens[0] >= 2 ? repLens[0] + 1 : 2;
                for (int k = 0; k < nm; k++)
                {
                    int ml = mLen[k]; if (startL > ml) continue;
                    int d = mDist[k];
                    int dp0 = DistPrice(d, 0), dp1 = DistPrice(d, 1), dp2 = DistPrice(d, 2), dp3 = DistPrice(d, 3);
                    for (int L = startL; L <= ml; L++)
                    {
                        int ls = L - 2; int dpr = ls == 0 ? dp0 : ls == 1 ? dp1 : ls == 2 ? dp2 : dp3;
                        Upd(cur + L, normalMatchPrice + lenPr[ps * 272 + L - 2] + dpr, cur, d + 4);
                    }
                    startL = ml + 1;
                }
                cur++;
            }
            // backtrack
            int cnt = 0, c = finalIdx;
            while (c > 0) { cnt++; c = oPrev[c]; }
            int total = cnt + (extraLen > 0 ? 1 : 0);
            int j = cnt - 1; c = finalIdx;
            while (c > 0) { int pr = oPrev[c]; tLen[j] = c - pr; tBack[j] = oBack[c]; j--; c = pr; }
            if (extraLen > 0) { tLen[cnt] = extraLen; tBack[cnt] = extraBack; }
            return total;
        }

        void EncLen(ushort[] p, int l, int ps)
        {
            if (l < 8) { rc.Bit(p, 0, 0); rc.Tree(p, 2 + ps * 8, 3, l); }
            else if (l < 16) { rc.Bit(p, 0, 1); rc.Bit(p, 1, 0); rc.Tree(p, 34 + ps * 8, 3, l - 8); }
            else { rc.Bit(p, 0, 1); rc.Bit(p, 1, 1); rc.Tree(p, 66, 8, l - 16); }
        }

        void EncodeOp(int p, int L, int back)
        {
            int ps = p & 3; int st = state;
            if (back < 0)
            {
                rc.Bit(m.IsMatch, (st << 4) + ps, 0);
                int prevB = p > 0 ? buf[p - 1] : 0; int b = buf[p]; int bs = 0x300 * (prevB >> 5); int sym = 1;
                if (st >= 7)
                {
                    int mb = buf[p - reps[0] - 1]; bool matched = true;
                    for (int i = 7; i >= 0; i--)
                    {
                        int bit = (b >> i) & 1;
                        if (matched)
                        {
                            int mbit = (mb >> i) & 1;
                            rc.Bit(m.Lit, bs + ((1 + mbit) << 8) + sym, bit);
                            if (mbit != bit) matched = false;
                        }
                        else rc.Bit(m.Lit, bs + sym, bit);
                        sym = (sym << 1) | bit;
                    }
                }
                else rc.Tree(m.Lit, bs, 8, b);
                state = st < 4 ? 0 : (st < 10 ? st - 3 : st - 6);
                return;
            }
            rc.Bit(m.IsMatch, (st << 4) + ps, 1);
            if (back < 4)
            {
                rc.Bit(m.IsRep, st, 1);
                if (back == 0)
                {
                    rc.Bit(m.IsRepG0, st, 0);
                    if (L == 1) { rc.Bit(m.IsRep0Long, (st << 4) + ps, 0); state = st < 7 ? 9 : 11; return; }
                    rc.Bit(m.IsRep0Long, (st << 4) + ps, 1);
                }
                else
                {
                    rc.Bit(m.IsRepG0, st, 1);
                    if (back == 1) rc.Bit(m.IsRepG1, st, 0);
                    else { rc.Bit(m.IsRepG1, st, 1); rc.Bit(m.IsRepG2, st, back - 2); }
                    int d = reps[back];
                    for (int k = back; k > 0; k--) reps[k] = reps[k - 1];
                    reps[0] = d;
                }
                EncLen(m.RepLen, L - 2, ps);
                state = st < 7 ? 8 : 11;
            }
            else
            {
                rc.Bit(m.IsRep, st, 0);
                EncLen(m.Len, L - 2, ps);
                int d = back - 4; int ls = L - 2 < 3 ? L - 2 : 3;
                int slot = GetSlot(d);
                rc.Tree(m.PosSlot, ls << 6, 6, slot);
                if (slot >= 4)
                {
                    int nd = (slot >> 1) - 1; int bv = (2 | (slot & 1)) << nd; int red = d - bv;
                    if (slot < 14) rc.RevTree(m.PosSpec, bv - slot - 1, nd, red);
                    else { rc.Direct((uint)(red >> 4), nd - 4); rc.RevTree(m.Align, 0, 4, red & 15); }
                }
                reps[3] = reps[2]; reps[2] = reps[1]; reps[1] = reps[0]; reps[0] = d;
                state = st < 7 ? 7 : 10;
            }
        }

        public void Run(Progress progress)
        {
            RefreshPrices();
            int pos = 0, since = 0; long nextReport = 0;
            while (pos < end)
            {
                int nd = Optimum(pos);
                for (int k = 0; k < nd; k++) { EncodeOp(pos, tLen[k], tBack[k]); pos += tLen[k]; }
                since += nd;
                if (since >= 1024) { RefreshPrices(); since = 0; }
                if (progress != null && pos >= nextReport) { progress(pos, end, outS.Length); nextReport = pos + (4 << 20); }
            }
            rc.Flush();
            if (progress != null) progress(end, end, outS.Length);
        }
    }

    public static class Packer
    {
        static bool IsNativePE(byte[] d)
        {
            if (d.Length < 0x40 || d[0] != 'M' || d[1] != 'Z') return false;
            int pe = BitConverter.ToInt32(d, 0x3C);
            if (pe < 0 || pe + 24 + 2 > d.Length || d[pe] != 'P' || d[pe + 1] != 'E' || d[pe + 2] != 0 || d[pe + 3] != 0) return false;
            int opt = pe + 24; int magic = BitConverter.ToUInt16(d, opt);
            int dirs; if (magic == 0x10B) dirs = opt + 96; else if (magic == 0x20B) dirs = opt + 112; else return false;
            int clr = dirs + 14 * 8;
            if (clr + 8 > d.Length) return true;
            return BitConverter.ToInt32(d, clr + 4) == 0; // no CLR header -> native code
        }

        public static string Pack(string srcDir, string outDir, string baseName, string[] excludeRootFiles, int dictBits, int nice, int cut, int partSize, bool deleteSource)
        {
            System.Diagnostics.Stopwatch sw = System.Diagnostics.Stopwatch.StartNew();
            string root = Path.GetFullPath(srcDir).TrimEnd('\\', '/');
            Manifest man = new Manifest();
            List<string> dirs = new List<string>();
            foreach (string d in Directory.GetDirectories(root, "*", SearchOption.AllDirectories)) dirs.Add(d.Substring(root.Length + 1).Replace('\\', '/'));
            dirs.Sort(StringComparer.Ordinal);
            man.Dirs.AddRange(dirs);
            List<string> files = new List<string>();
            Regex partRx = new Regex("^" + Regex.Escape(baseName) + @"\.\d{3}$", RegexOptions.IgnoreCase);
            Dictionary<string, bool> excl = new Dictionary<string, bool>(StringComparer.OrdinalIgnoreCase);
            if (excludeRootFiles != null) foreach (string x in excludeRootFiles) excl[x] = true;
            foreach (string f in Directory.GetFiles(root, "*", SearchOption.AllDirectories))
            {
                string rel = f.Substring(root.Length + 1).Replace('\\', '/');
                if (rel.IndexOf('/') < 0 && (excl.ContainsKey(rel) || partRx.IsMatch(rel))) continue; // tool files / old archive
                files.Add(rel);
            }
            files.Sort(StringComparer.Ordinal);

            Dictionary<string, int> byHash = new Dictionary<string, int>();
            List<byte[]> blobData = new List<byte[]>(); List<byte[]> blobHash = new List<byte[]>(); List<string> blobKey = new List<string>(); List<bool> blobNative = new List<bool>();
            List<int> fileBlob = new List<int>();
            long rawTotal = 0;
            using (SHA256 sha = SHA256.Create())
            {
                foreach (string rel in files)
                {
                    string full = Path.Combine(root, rel.Replace('/', '\\'));
                    byte[] d = File.ReadAllBytes(full); rawTotal += d.Length;
                    byte[] h = sha.ComputeHash(d); string hk = Convert.ToBase64String(h);
                    int bi;
                    if (!byHash.TryGetValue(hk, out bi))
                    {
                        bi = blobData.Count; byHash[hk] = bi;
                        bool native = IsNativePE(d);
                        string ext = Path.GetExtension(rel).ToLowerInvariant();
                        blobData.Add(d); blobHash.Add(h); blobNative.Add(native);
                        blobKey.Add(ext + "\u0001" + (native ? "0" : "1") + "\u0001" + Path.GetFileName(rel).ToLowerInvariant() + "\u0001" + rel);
                    }
                    fileBlob.Add(bi);
                    man.FilePath.Add(rel);
                    man.FileTime.Add(File.GetLastWriteTimeUtc(full).Ticks);
                }
            }
            int nb = blobData.Count;
            int[] order = new int[nb]; for (int i = 0; i < nb; i++) order[i] = i;
            string[] keys = blobKey.ToArray();
            Array.Sort(keys, order, StringComparer.Ordinal);
            int[] newIdx = new int[nb]; for (int i = 0; i < nb; i++) newIdx[order[i]] = i;
            foreach (int b in fileBlob) man.FileBlob.Add(newIdx[b]);

            long total = 0; foreach (byte[] d in blobData) total += d.Length;
            if (total > int.MaxValue - 4096) throw new InvalidOperationException("input too large (> 2GB)");
            byte[] all = new byte[total]; int off = 0;
            for (int i = 0; i < nb; i++)
            {
                int bi = order[i]; byte[] d = blobData[bi];
                Buffer.BlockCopy(d, 0, all, off, d.Length);
                if (blobNative[bi]) X86.Run(all, off, d.Length, true);
                man.BlobLen.Add(d.Length); man.BlobFilter.Add((byte)(blobNative[bi] ? 1 : 0)); man.BlobHash.Add(blobHash[bi]);
                off += d.Length;
            }
            blobData = null;
            int db = dictBits; while (db > 16 && (1L << (db - 1)) >= total) db--;
            man.DictBits = db; man.StreamLen = total;

            MemoryStream cs = new MemoryStream();
            LzEncoder enc = new LzEncoder(all, (int)total, db, nice, cut, cs);
            enc.Run(delegate(long done, long tot, long ob)
            {
                Console.Write("\r  {0,5:0.0}%  {1,6:0.0} MB -> {2,6:0.0} MB  {3:0}s   ", tot == 0 ? 100.0 : done * 100.0 / tot, done / 1048576.0, ob / 1048576.0, sw.Elapsed.TotalSeconds);
            });
            Console.WriteLine();
            enc = null; all = null; GC.Collect();

            byte[] mbytes = man.Serialize();
            MemoryStream arc = new MemoryStream();
            arc.Write(Unpacker.Magic, 0, 4);
            arc.Write(BitConverter.GetBytes(mbytes.Length), 0, 4);
            arc.Write(mbytes, 0, mbytes.Length);
            cs.WriteTo(arc);
            byte[] a = arc.ToArray(); cs = null; arc = null;

            Console.WriteLine("  verifying (decode + SHA-256 check)...");
            Unpacker.Run(a, null);

            foreach (string f in Directory.GetFiles(outDir)) if (partRx.IsMatch(Path.GetFileName(f))) File.Delete(f);
            int parts = 0;
            for (int p = 0; p < a.Length || parts == 0; p += partSize)
            {
                int n = Math.Min(partSize, a.Length - p);
                using (FileStream fs = new FileStream(Path.Combine(outDir, baseName + "." + parts.ToString("D3")), FileMode.Create, FileAccess.Write))
                    fs.Write(a, p, n);
                parts++;
            }
            string result = string.Format("  {0} files ({1} unique), {2:N0} bytes -> {3:N0} bytes ({4:0.00}%), {5} part(s), {6:0}s",
                files.Count, nb, rawTotal, a.Length, rawTotal == 0 ? 0 : a.Length * 100.0 / rawTotal, parts, sw.Elapsed.TotalSeconds);
            a = null;

            if (deleteSource)
            {
                // Re-read the written parts from disk and verify again before deleting anything.
                Console.WriteLine("  verifying written files (decode + SHA-256 check)...");
                string[] partFiles = new string[parts];
                for (int k = 0; k < parts; k++) partFiles[k] = Path.Combine(outDir, baseName + "." + k.ToString("D3"));
                Unpacker.Unpack(partFiles, null);
                Console.WriteLine("  deleting original files...");
                // Delete only the files that were packed, then the now-empty directories (deepest first).
                foreach (string rel in files)
                {
                    string full = Path.Combine(root, rel.Replace('/', '\\'));
                    if (!File.Exists(full)) continue;
                    File.SetAttributes(full, FileAttributes.Normal);
                    File.Delete(full);
                }
                List<string> ds = new List<string>(dirs);
                ds.Sort(delegate(string x, string y) { return y.Length.CompareTo(x.Length); });
                foreach (string rel in ds)
                {
                    string full = Path.Combine(root, rel.Replace('/', '\\'));
                    if (Directory.Exists(full) && Directory.GetFileSystemEntries(full).Length == 0) Directory.Delete(full);
                }
            }
            return result;
        }
    }
}
