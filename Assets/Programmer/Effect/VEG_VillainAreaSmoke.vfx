  m_Script: {fileID: 11500000, guid: 833c3541f2af4b28b080abc2cd1a804d, type: 3}
  m_Name:
  m_EditorClassIdentifier: Unity.VisualEffectGraph.Editor::UnityEditor.VFX.Block.CustomHLSL
  m_UIIgnoredErrors: []
  m_Parent: {fileID: 114946465509916290}
  m_Children: []
  m_UIPosition: {x: 0, y: 0}
  m_UICollapsed: 0
  m_UISuperCollapsed: 0
  m_InputSlots:
  - {fileID: 8926484042661630019}
  - {fileID: 8926484042661630020}
  - {fileID: 8926484042661630021}
  - {fileID: 8926484042661630022}
  - {fileID: 8926484042661630023}
  m_OutputSlots: []
  m_Disabled: 0
  m_ActivationSlot: {fileID: 8926484042661614934}
  m_BlockName: Flow Spawn
  m_HLSLCode: "void FlowSpawn(inout VFXAttributes attributes, in VFXSampler2D PathTexture, in float PathLength, in float SpawnRadius, in float FlowSpeed, in float FlowHeight)\n{\n    // 出現点(道の始点)のまわりの円の中に生まれる\n    float4 start = LoadTexture(PathTexture, int3(0, 0, 0));\n    float4 startWidth = LoadTexture(PathTexture, int3(0, 1, 0));\n    float radius = min(max(SpawnRadius, 0.1), max(min(startWidth.x, startWidth.y), 0.5));\n    float angle = Rand(attributes.seed) * 6.2831853;\n    float r = sqrt(Rand(attributes.seed)) * radius;\n    float layer = Rand(attributes.seed);\n    attributes.position = start.xyz + float3(cos(angle) * r, layer * layer * max(FlowHeight, 0.0), sin(angle) * r);\n    attributes.velocity = float3(0.0, 0.0, 0.0);\n\n    // 粒ごとの値: x = 道の横の位置(-1 = 左の壁, 1 = 右の壁。その間の全体の幅で均等), y = 高さの段(0..1), z = 入口で消える前後の位置(-0.5..0.5)\n    attributes.targetPosition = float3(Rand(attributes.seed) * 2.0 - 1.0, layer, Rand(attributes.seed) - 0.5);\n    // x = 入口の壁にどれだけなじんだか(0 = 流れている, 1 = 壁), y = 粒の大きさの倍率, z = 入口に着いて消える量(どれもUpdateで決める)\n    attributes.direction = float3(0.0, 0.0, 0.0);\n\n    // 寿命 = 入口の先(壁の奥行きの分 + 消えていく分、5m)まで流れる時間。粒ごとの速さ(Updateと同じ式)に合わせ、途中で消えないようにする\n    // 消えるのは寿命ではなく、入口の消える位置に着いた時(Flow Along Path の arrival)\n    float speedScale = 0.85 + 0.3 * frac(attributes.targetPosition.x * 37.3 + attributes.targetPosition.y * 11.7);\n    attributes.lifetime = (max(PathLength, 0.0) + 5.0) / max(FlowSpeed * speedScale, 0.05);\n}\n"
  m_ShaderFile: {fileID: 0}
  m_AvailableFunction:
    selection: FlowSpawn
    selectedIndex: 0
