{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "3187bdf89db649d997ed5cfcb159b146",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "NTE_CastShadowTint (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": 43.00002670288086,
            "y": 419.99993896484375,
            "width": 275.9999694824219,
            "height": 421.99993896484375
        }
    },
    "m_Slots": [
        {
            "m_Id": "303b418fe672484686a41f65c1c57ba4"
        },
        {
            "m_Id": "03da5fb3401e4817a270654e7f9d4664"
        },
        {
            "m_Id": "767458f42e5e4c00ae74d8ff024329e4"
        },
        {
            "m_Id": "4617f50758324df68c353a877e445fa2"
        },
        {
            "m_Id": "d26604e318a641b18be36137b4d150f4"
        },
        {
            "m_Id": "9571ad0e2dbe4abea64f37558cd8c728"
        },
        {
            "m_Id": "e6db9569964d41889d163c4d5439de77"
        },
        {
            "m_Id": "bb91876ec1854e08bef0c78f6ef6b773"
        }
    ],
    "synonyms": [],
    "m_Precision": 0,
    "m_PreviewExpanded": true,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "NTE_CastShadowTint",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "// Cast shadow colour = texture colour x ShadowColor. Faded out on faces already turned away from the light\n// (the cel band shades those) so self-shadow acne at the terminator does not show as dirty blotches.\nfloat ndl = dot(NormalWS * rsqrt(max(dot(NormalWS, NormalWS), 1e-6)), LightDir * rsqrt(max(dot(LightDir, LightDir), 1e-6)));\nfloat fade = 1.0; // (ndl kept for reference) shadows from every light must show, e.g. skirt -> thighs under the spot\nShadowTint = $precision4(max(Albedo * BaseColor, 0.0) * saturate(Tint) * 0.5, saturate(Strength) * fade);"
}

