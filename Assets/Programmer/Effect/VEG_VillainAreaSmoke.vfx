  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 833c3541f2af4b28b080abc2cd1a804d, type: 3}
  m_Name:
  m_EditorClassIdentifier: Unity.VisualEffectGraph.Editor::UnityEditor.VFX.Block.CustomHLSL
  m_UIIgnoredErrors: []
  m_Parent: {fileID: 114780028408030698}
  m_Children: []
  m_UIPosition: {x: 0, y: 0}
  m_UICollapsed: 0
  m_UISuperCollapsed: 0
  m_InputSlots:
  - {fileID: 8926484042661630026}
  - {fileID: 8926484042661630027}
  - {fileID: 8926484042661630028}
  - {fileID: 8926484042661630029}
  - {fileID: 8926484042661630030}
  - {fileID: 8926484042661630031}
  - {fileID: 8926484042661630032}
  - {fileID: 8926484042661630033}
  - {fileID: 8926484042661630034}
  m_OutputSlots: []
  m_Disabled: 0
  m_ActivationSlot: {fileID: 8926484042661630025}
  m_BlockName: Flow Along Path
  m_HLSLCode: "void FlowAlongPath(inout VFXAttributes attributes, in VFXSampler2D PathTexture, in float PathCount, in float PathLength, in float FlowSpeed, in float FlowHeight, in float WallBlend, in float FlowParticleScale, in float Height, in float Depth)\n{\n    // 道(折れ線)の上で一番近い点を、真上から見て探す。最後の区間だけ入口の先まで延ばす\n    int count = clamp((int)PathCount, 2, 8);\n    float3 pos = attributes.position;\n    float bestDist = 1e9;\n    float bestS = 0.0;\n    float3 bestPoint = pos;\n    float3 bestTangent = float3(0.0, 0.0, 1.0);\n    float leftWidth = 1.0;\n    float rightWidth = 1.0;\n    for (int i = 0; i < 7; i++)\n    {\n        if (i >= count - 1) break;\n        float4 a = LoadTexture(PathTexture, int3(i, 0, 0));\n        float4 b = LoadTexture(PathTexture, int3(i + 1, 0, 0));\n        float2 ab = b.xz - a.xz;\n        float len2 = max(dot(ab, ab), 0.0001);\n        float maxT = (i == count - 2) ? 1000.0 : 1.0;\n        float t = clamp(dot(pos.xz - a.xz, ab) / len2, 0.0, maxT);\n        float3 p = float3(a.x + ab.x * t, lerp(a.y, b.y, saturate(t)), a.z + ab.y * t);\n        float d = distance(pos.xz, p.xz);\n        if (d < bestDist)\n        {\n            // 2行目 = その点での左右の壁までの距離\n            float4 wa = LoadTexture(PathTexture, int3(i, 1, 0));\n            float4 wb = LoadTexture(PathTexture, int3(i + 1, 1, 0));\n            bestDist = d;\n            bestS = a.w + (b.w - a.w) * t;\n            bestPoint = p;\n            bestTangent = normalize(float3(ab.x, 0.0, ab.y));\n            leftWidth = lerp(wa.x, wb.x, saturate(t));\n            rightWidth = lerp(wa.y, wb.y, saturate(t));\n        }\n    }\n    float3 side = float3(-bestTangent.z, 0.0, bestTangent.x);\n    float lateral = dot(pos - bestPoint, side);\n\n    // 一定の速さで入口まで流れる(粒ごとに少し速さを変えて筋を作る)。入口の消える位置を過ぎた粒は薄れて消える\n    float speedScale = 0.85 + 0.3 * frac(attributes.targetPosition.x * 37.3 + attributes.targetPosition.y * 11.7);\n    float speed = FlowSpeed * speedScale;\n    float endS = PathLength + attributes.targetPosition.z * Depth;\n    float arrival = saturate((bestS - endS + 1.0) / 2.0);\n\n    // 0 = 道を流れている, 1 = 入口(高さだけ今の壁に近づける。幅は路地の幅のまま)\n    float wall = smoothstep(PathLength - max(WallBlend, 0.01), PathLength, bestS);\n\n    // 横は出現点から路地の幅(左右の壁まで)いっぱいに広がっていく\n    // 左の壁から右の壁までの全体の幅の中で均等に選ぶ(左右に半分ずつ分けると、狭い側だけ濃くなるため)\n    float spread = saturate(bestS / 6.0);\n    float targetLateral = lerp(-leftWidth, rightWidth, attributes.targetPosition.x * 0.5 + 0.5);\n    targetLateral *= spread;\n\n    // 高さは地面すれすれ(Flow Height)から、入口で壁の高さ(Height)まで。道の点は地面の高さに合わせてある\n    float layer = attributes.targetPosition.y;\n    float flowY = layer * layer * max(FlowHeight, 0.0);\n    float wallY = pow(layer, 1.3) * max(Height, 0.0);\n    float targetY = bestPoint.y + lerp(flowY, wallY, wall);\n\n    float3 desired = bestTangent * speed + side * (targetLateral - lateral) * 0.8 + float3(0.0, (targetY - pos.y) * 2.0, 0.0);\n    attributes.velocity = lerp(attributes.velocity, desired, 0.1);\n\n    // 地面より下には沈まない\n    attributes.position.y = max(pos.y, bestPoint.y);\n    // x = 入口の壁になじんだ量, y = 粒の大きさの倍率(流れている途中は大きく、入口で今の大きさに戻る), z = 入口に着いて消える量\n    attributes.direction = float3(wall, lerp(max(FlowParticleScale, 0.01), 1.0, wall), arrival);\n}\n"
  m_ShaderFile: {fileID: 0}
  m_AvailableFunction:
    selection: FlowAlongPath
    selectedIndex: 0
