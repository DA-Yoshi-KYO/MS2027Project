 <node id="1423728722" visible="true" version="7" changeset="188396681" timestamp="2026-09-02T02:18:45Z" user="Monolo23" uid="17519482" lat="35.6795681" lon="139.7716193">
  <tag k="alt_name" v="八重洲のキリン像"/>
  <tag k="alt_name:en" v="Giraffe statue"/>
  <tag k="alt_name:es" v="Estatua de la Jirafa de Yaesu"/>
  <tag k="alt_name:ja" v="八重洲のキリン像"/>
  <tag k="alt_name:ja-Hira" v="やえすのきりんぞう"/>
  <tag k="alt_name:ja-Latn" v="Yaesu no Kirin-zō"/>
  <tag k="artist_name" v="安藤泉"/>
  <tag k="artist_name:en" v="Izumi Ando;Izumi Andoh;ANDÔ Izumi"/>
  <tag k="artist_name:ja" v="安藤泉"/>
  <tag k="artist:wikidata" v="Q136296573"/>
  <tag k="artwork_type" v="sculpture"/>
  <tag k="contact:tripadvisor" v="https://tripadvisor.com/Attraction_Review-g14129589-d25280169-Reviews-Giraffe_statue-Nihonbashi_Chuo_Tokyo_Tokyo_Prefecture_Kanto.html"/>
  <tag k="description" v="1989年に東京駅八重洲口近くに設置された安藤泉の金属製キリンの彫刻。高さ6.25mで、伝統的な中国医学の王としてのキリンを象徴する冠をかぶっており、元の設置場所である津村ビルを示している。"/>
  <tag k="description:en" v="Metal giraffe sculpture by Izumi Andoh, installed in 1989 near Tokyo Station Yaesu exit. It stands 6.25m tall and wears a crown symbolizing the giraffe as king of traditional Chinese medicine, a nod to its original location at Tsumura Building."/>
  <tag k="description:es" v="Escultura metálica de jirafa por Izumi Andoh, instalada en 1989 cerca de la salida Yaesu de la estación de Tokio. Mide 6,25 m y lleva corona que simboliza a la jirafa como rey de la medicina tradicional china."/>
  <tag k="description:fr" v="Sculpture métallique de girafe par Izumi Andoh, installée en 1989 près de la sortie Yaesu de la gare de Tokyo. Elle mesure 6,25 m et porte une couronne symbolisant la girafe comme roi de la médecine traditionnelle chinoise."/>
  <tag k="description:ja" v="1989年に東京駅八重洲口近くに設置された安藤泉の金属製キリンの彫刻。高さ6.25mで、伝統的な中国医学の王としてのキリンを象徴する冠をかぶっており、元の設置場所である津村ビルを示している。"/>
  <tag k="description:ko" v="1989년에 도쿄역 야에스 출구 근처에 설치된 이즈미 안도의 금속 기린 조각상. 높이 6.25m로 전통 중국 의학의 왕을 상징하는 왕관을 쓰고 있으며, 원래 위치인 츠무라 빌딩을 상징한다."/>
  <tag k="description:zh" v="由安藤泉于1989年安装在东京站八重洲出口附近的金属长颈鹿雕塑。高6.25米，戴着象征传统中医之王的冠冕，象征其最初位于津村大厦。"/>
  <tag k="height" v="6.25"/>
  <tag k="level" v="0"/>
  <tag k="material" v="metal"/>
  <tag k="name" v="オベリスク・ジラフ"/>
  <tag k="name:en" v="Obelisk Giraffe"/>
  <tag k="name:es" v="Obelisco Jirafa"/>
  <tag k="name:ja" v="オベリスク・ジラフ"/>
  <tag k="name:ja-Hira" v="おべりすく・じらふ"/>
  <tag k="name:ja-Latn" v="Oberisuku Jirafu"/>
  <tag k="start_date" v="1989"/>
  <tag k="tourism" v="artwork"/>
  <tag k="wheelchair" v="yes"/>
 </node>
